# Contentful
CONTENTFUL_SPACE_ID=your_space_id
CONTENTFUL_ACCESS_TOKEN=your_delivery_api_token
CONTENTFUL_PREVIEW_TOKEN=your_preview_api_token
CONTENTFUL_MANAGEMENT_TOKEN=your_management_token

# Environment
PUBLIC_SITE_URL=https://recconnect.co

# Optional: Analytics
PUBLIC_GA_ID=
PUBLIC_GTM_ID=

# Forms — email notifications via Resend (required for forms to send)
RESEND_API_KEY=
CONTACT_TO=enquiries@recconnect.co
CONTACT_FROM=RecConnect <noreply@recconnect.co>

# Forms — optional lead storage in Airtable (leave blank to skip)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Submissions
