---
/**
 * LogoWall — tiled RecConnect logo mark used as a background texture.
 * Renders an inline SVG <pattern> of the wordmark repeated on a diagonal.
 * Unique IDs per instance so multiple walls can sit on one page.
 *
 * Props:
 *   color     fill of the marks (default mint)
 *   opacity   per-mark opacity (default 0.1)
 *   size      mark width in px within the tile (default 120)
 *   angle     pattern rotation in degrees (default -45)
 *   class     extra classes on the root <svg>
 */
interface Props {
  color?: string;
  opacity?: number;
  size?: number;
  angle?: number;
  class?: string;
}
const {
  color = '#2dd4bf',
  opacity = 0.1,
  size = 120,
  angle = -45,
  class: className = '',
} = Astro.props;

const uid = 'rcw-' + Math.random().toString(36).slice(2, 8);
const markH = Math.round((size * 46) / 285);
const tileW = size + 64;
const tileH = (markH + 54) * 2;
