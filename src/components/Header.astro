---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Suppliers', href: '/suppliers' },
  { label: 'Partners', href: '/partners' },
  { label: 'Insights', href: '/insights' },
  { label: 'Events', href: '/events' },
  { label: 'Contact', href: '/contact' },
];

// Mobile menu uses fuller, clearer labels (more room than the top bar)
const mobileNavItems = [
  { label: 'Home', href: '/' },
  { label: 'Supplier Directory', href: '/suppliers' },
  { label: 'Become a Partner', href: '/partners' },
  { label: 'Member Benefits', href: '/join' },
  { label: 'Insights', href: '/insights' },
  { label: 'Events', href: '/events' },
  { label: 'Contact', href: '/contact' },
];

const CONNECTED_URL = '/connected-2026';
const BOOK_URL = 'https://www.amazon.co.uk/dp/B0H4NF36K8?ref=cm_sw_r_ffobk_cp_ud_dp_8QP171CNN3TK5E1GSWHF&bestFormat=true';

const currentPath = Astro.url.pathname;
---

<style is:global>
  #nav-logo {
    height: 1.65rem;
    width: auto;
  }
  @media (min-width: 768px) {
    #nav-logo {
      height: 2rem;
    }
  }
</style>

<header
  id="site-header"
  class="absolute top-0 left-0 right-0 z-50"
>
  <nav class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="flex items-center justify-between py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <img
          src="/images/recconnect-lockup-brand.svg"
          alt="RecConnect"
          id="nav-logo"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-sm font-medium transition-colors',
              currentPath === item.href
                ? 'text-primary'
                : 'text-white/80 hover:text-white',
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- CTA Button -->
      <div class="hidden md:block">
        <a
          href="/join"
          class="inline-flex items-center justify-center bg-primary hover:bg-primary-dark text-brand-navy px-5 py-2 text-sm font-semibold rounded-lg transition-colors"
        >
          Join Today
          <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="md:hidden p-2 text-white"
        aria-label="Toggle menu"
        id="mobile-menu-toggle"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

  </nav>

  <!-- Mobile Navigation (full-screen overlay) -->
  <div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-[60] bg-[#0a0b0f] overflow-y-auto">
    <!-- overlay top bar -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-white/10">
      <a href="/" class="flex items-center">
        <img src="/images/recconnect-lockup-brand.svg" alt="RecConnect" class="h-7 w-auto" />
      </a>
      <button type="button" id="mobile-menu-close" class="p-2 -mr-2 text-white" aria-label="Close menu">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="px-6 pt-2 pb-10 flex flex-col">
      {mobileNavItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-lg font-medium py-3.5 border-b border-white/5 transition-colors',
            currentPath === item.href ? 'text-primary' : 'text-white/85 hover:text-white',
          ]}
        >
          {item.label}
        </a>
      ))}

      <a
        href="/join"
        class="inline-flex items-center justify-center bg-primary hover:bg-primary-dark text-brand-navy px-5 py-3.5 text-base font-semibold rounded-lg transition-colors mt-5"
      >
        Join Today
      </a>

      <!-- CONNECTED 2026 callout -->
      <a href={CONNECTED_URL} class="mt-6 block rounded-xl border border-[#f2b33d]/40 bg-[#f2b33d]/[0.08] p-4 transition-colors hover:bg-[#f2b33d]/[0.14]">
        <span class="block text-[0.7rem] font-semibold tracking-[0.18em] uppercase text-[#f2b33d]">Flagship event · This November</span>
        <p class="mt-1.5 text-xl font-bold text-white leading-tight">CONNECTED 2026</p>
        <p class="mt-1 text-sm text-white/70">An immersive day at BOX Piccadilly, London. Members get priority access and discounted tickets.</p>
        <span class="mt-2.5 inline-flex items-center gap-1 text-sm font-semibold text-[#f2b33d]">Get tickets
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </span>
      </a>

      <!-- Book advert -->
      <a href={BOOK_URL} target="_blank" rel="noopener noreferrer" class="mt-4 flex gap-4 rounded-xl border border-white/10 bg-white/[0.03] p-4 transition-colors hover:bg-white/[0.06]">
        <img src="/images/simon-book.jpg" alt="The Agile Recruiter by Simon Lewis" class="w-16 h-auto self-start rounded shadow-lg shadow-black/50" loading="lazy" />
        <div class="min-w-0">
          <span class="block text-[0.7rem] font-semibold tracking-[0.14em] uppercase text-[#f2b33d]">New from our founder</span>
          <p class="mt-1 text-base font-bold text-white leading-tight">The Agile Recruiter</p>
          <p class="mt-0.5 text-sm text-white/60 leading-snug">A leader's guide to running a modern SME recruitment business.</p>
          <span class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-[#f2b33d]">Buy on Amazon
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </span>
        </div>
      </a>
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const menuClose = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');

  const openMenu = () => { menu?.classList.remove('hidden'); document.body.style.overflow = 'hidden'; };
  const closeMenu = () => { menu?.classList.add('hidden'); document.body.style.overflow = ''; };

  menuToggle?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);

  // close after tapping any link, and on Escape
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
</script>
