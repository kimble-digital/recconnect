---
import LogoWall from '@/components/LogoWall.astro';
---

<section class="relative bg-brand-navy overflow-hidden min-h-screen flex items-center">
  <!-- Repeating-logo wallpaper + dark radial gradient -->
  <div class="absolute inset-0 z-0">
    <LogoWall color="#2dd4bf" opacity={0.1} size={130} class="absolute inset-0 w-full h-full" />
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse at 50% 42%, rgba(26,31,46,0.55), rgba(26,31,46,0.97) 72%);"
    ></div>
  </div>

  <!-- Mint glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[760px] h-[380px] bg-primary/10 rounded-full blur-[150px] z-0"></div>

  <!-- Content -->
  <div class="relative z-10 container-wide pt-40 pb-20 w-full">
    <div class="max-w-4xl">
    <p class="kicker inline-flex items-center gap-2.5 rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-[0.78rem] text-primary mb-7">
      <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
      For leaders of independent recruitment agencies
    </p>

    <h1 class="font-display uppercase text-white leading-[0.9] mb-7 text-5xl sm:text-6xl lg:text-7xl">
      Join the Club. Connect.
      <br />
      Grow.
      <span class="relative inline-block">Get Results.<svg
          class="absolute left-[-1%] -bottom-2 md:-bottom-3 w-[102%] h-3 md:h-4"
          viewBox="0 0 320 22"
          preserveAspectRatio="none"
          aria-hidden="true"
        ><path d="M6 13 Q 90 4 165 9 Q 250 14 314 6 Q 250 22 165 17 Q 90 12 6 19 Z" fill="#2dd4bf" /></svg></span>
    </h1>

    <p class="text-xl lg:text-2xl text-slate-200 mb-5 max-w-2xl leading-relaxed">
      The community where established recruitment leaders meet, learn, and grow. Events worth turning up for, peer groups that get it, and connections that move your business forward.
    </p>

    <p class="text-base md:text-lg text-slate-400 mb-9 max-w-xl leading-relaxed">
      Curated rooms. Real conversations. The people who actually shape the industry. No noise, no hard sell.
    </p>

    <!-- Primary CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-start">
      <a
        href="https://buy.stripe.com/3cI00lczo8Hk8QA3JY0kE06"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-base px-8 py-3.5"
      >
        Join the Club · £39/month
      </a>
      <a href="#pricing" class="btn-outline-light text-base px-8 py-3.5">
        See what's included
      </a>
    </div>

    <!-- Free tier funnel -->
    <p class="text-sm md:text-base text-slate-400 mt-7">
      Not ready to commit?
      <a
        href="https://chat.whatsapp.com/B9IcWZkj7fIEU806wCpsnZ"
        target="_blank"
        rel="noopener noreferrer"
        class="text-primary hover:text-primary-light underline underline-offset-4 decoration-primary/40"
      >
        Join the free Core community
      </a>
      for the member directory, insights, and event invites.
    </p>

    <!-- Supplier signpost -->
    <p class="text-xs md:text-sm text-slate-500 mt-3">
      A supplier to the industry?
      <a href="/suppliers" class="text-slate-300 hover:text-primary underline underline-offset-2 transition-colors">
        Partner with RecConnect →
      </a>
    </p>
    </div>
  </div>
</section>
