---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhotoMarquee from '@/components/PhotoMarquee.astro';

const ENQUIRE = '#enquire';

const reasons = [
  {
    title: 'Small rooms, real conversations',
    body: "No stand to man, no badge scanners, no shouting over a conference floor. Just a room of 20 to 100 people who are there because Simon personally curated the list. Every one of them is a potential customer.",
  },
  {
    title: 'Peer trust transfers to you',
    body: 'Agency owners talk to each other. When you are part of RecConnect, mentioned in the newsletter, presenting at a lunch, listed in the directory, you inherit credibility from the community itself. You cannot buy that in a magazine.',
  },
  {
    title: 'Decision-makers, not gatekeepers',
    body: 'The RecConnect audience are the people who sign contracts. MDs and founders who decide which CRM to buy, which job board to use, which finance partner to appoint. One good conversation here beats fifty cold messages.',
  },
  {
    title: 'No exhibition noise',
    body: 'Events, roundtables, and lunches create the conditions for genuine conversations. People remember those. They do not remember a brochure they picked up at a conference.',
  },
];

const dataPoints = [
  'Full contact details for named decision-makers',
  'Sector and specialism categorisation',
  'Company headcount and growth stage',
  'The technology and tools each agency already uses',
];

const activations = [
  {
    kicker: 'Sponsor CONNECTED',
    title: 'Put your brand at the centre of the room.',
    body: "CONNECTED is the industry's most talked-about event, an immersive day that hundreds of senior recruitment leaders clear their diary for. Headline and category sponsorships put your brand on the stage and in the conversation, not on a forgotten lanyard. Ask us for the 2026 sponsorship pack.",
    img: '/images/members/connected-2026.jpg',
    ctaLabel: 'Request the 2026 sponsorship pack',
  },
  {
    kicker: 'Host a lunch',
    title: 'A table of decision-makers, all yours.',
    body: 'Host an intimate lunch for a curated table of around ten senior agency leaders, exactly the people you want in front of. We handle the guest list and the logistics, you bring the brand and the conversation. No stand, no pitch, just the right people over a long lunch, arranged and costed around what you want to achieve.',
    img: '/images/members/1778143388772.jpeg',
    ctaLabel: 'Enquire about hosting a lunch',
  },
];

const tiers = [
  {
    name: 'Category Partner',
    price: '£500',
    per: '/month',
    year: '£6,000 / year',
    tagline: 'Maximum visibility and category exclusivity',
    featured: true,
    features: [
      'Featured across the entire website',
      'Category sponsorship: exclusive ownership of your niche',
      'Enhanced supplier profile, custom designed',
      'Business contact profiles',
      'Featured placement in blogs and editorial',
      'Guest blog and webinar opportunities',
      'Included in every newsletter',
      'Dedicated email features to the community',
      'Priority sponsorship of events and lunches',
      'Premium access to the community database and sales insights hub',
    ],
  },
  {
    name: 'Featured Supplier',
    price: '£250',
    per: '/month',
    year: '£3,000 / year',
    tagline: 'Consistent visibility without full category ownership',
    featured: false,
    features: [
      'Listing within relevant categories',
      'Additional branding on selected category pages',
      'Single business contact profile',
      'Guest blog and webinar opportunities',
      'Mentions and links from relevant editorial',
      'Regular newsletter inclusion',
      'Priority sponsorship of events and lunches',
      'Access to the community database and sales insights hub',
    ],
  },
  {
    name: 'Listed Supplier',
    price: '£150',
    per: '/month',
    year: '£1,800 / year',
    tagline: 'A credible, discoverable presence on the platform',
    featured: false,
    features: [
      'Standard supplier profile (logo, overview, services)',
      'Listing within relevant categories',
      'Inclusion in platform search and directory',
      'Basic access to the community database and sales insights hub',
    ],
  },
  {
    name: 'Trainer Membership',
    price: '£240',
    per: '/year',
    year: 'Billed annually',
    tagline: 'For trainers and coaches in the network',
    featured: false,
    features: [
      'Listed supplier profile',
      'Inclusion in the trainer category',
      'Discoverable by agencies seeking training',
      'Eligibility for referrals and event opportunities',
    ],
  },
];
---

<BaseLayout
  title="Partner with RecConnect"
  description="Put your brand in front of a curated audience of senior independent recruitment agency leaders. Partner packages, audience data, and the community database."
>
  <!-- ═══ HERO ═══ -->
  <section class="relative overflow-hidden bg-brand-navy pt-36 pb-16 md:pt-44 md:pb-24 border-b border-white/10">
    <div class="absolute -top-16 -right-20 w-80 h-[30rem] bg-primary/[0.06] rotate-12 pointer-events-none" style="clip-path: polygon(20% 0, 100% 0, 80% 100%, 0 100%);"></div>
    <div class="absolute -bottom-24 -left-16 w-44 h-96 bg-coral/[0.05] -rotate-[18deg] pointer-events-none" style="clip-path: polygon(55% 0, 100% 0, 45% 100%, 0 100%);"></div>

    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <p class="kicker text-primary text-[0.8rem] mb-5">Partner with RecConnect</p>
        <h1 class="font-display uppercase text-white text-5xl md:text-7xl leading-[0.9] mb-6">
          Where suppliers
          <span class="font-script normal-case text-primary inline-block align-[-0.06em] leading-none text-7xl md:text-9xl ml-1">convert.</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-300 max-w-2xl leading-relaxed mb-4">
          Volume media sells reach. RecConnect sells access.
        </p>
        <p class="text-base md:text-lg text-slate-400 max-w-2xl leading-relaxed mb-9">
          Put your brand in front of a curated audience of senior independent agency leaders, the people who actually choose the tools, sign the contracts, and shape the market.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={ENQUIRE} class="btn-primary text-base px-8 py-3.5">Become a partner</a>
          <a href="#packages" class="btn-outline-light text-base px-8 py-3.5">See the packages</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHY PARTNERS CONVERT ═══ -->
  <section class="relative overflow-hidden bg-white py-20 md:py-28">
    <div class="absolute -top-12 -left-16 w-56 h-72 bg-primary/[0.07] -rotate-[16deg] pointer-events-none" style="clip-path: polygon(0 0, 100% 0, 40% 100%);"></div>
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <div class="max-w-3xl mb-14">
        <p class="kicker text-primary-dark text-[0.8rem] mb-4">The difference</p>
        <h2 class="font-display uppercase text-brand-navy text-4xl md:text-6xl leading-[0.95] mb-5">Fewer people. More deals.</h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          A supplier spending with a trade magazine gets a logo in front of thousands of readers, most of them geographically irrelevant, already locked into a competitor, or too small to convert. A RecConnect partner gets named placement with a curated senior UK audience, and a seat in the room at events those people actually want to attend.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {reasons.map((r) => (
          <div class="bg-slate-50 rounded-xl p-7 border border-slate-200 hover:border-primary/50 transition-colors">
            <div class="w-11 h-11 bg-primary icon-shard flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-brand-navy" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </div>
            <h3 class="text-lg font-bold text-brand-navy mb-2">{r.title}</h3>
            <p class="text-slate-600 leading-relaxed">{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <PhotoMarquee kicker="The rooms you'll be in" />

  <!-- ═══ THE DATA PLATFORM ═══ -->
  <section class="relative overflow-hidden bg-brand-navy py-20 md:py-28">
    <div class="absolute top-1/4 -right-10 w-28 h-[34rem] bg-primary/[0.06] rotate-[8deg] pointer-events-none" style="clip-path: polygon(55% 0, 100% 0, 45% 100%, 0 100%);"></div>
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <p class="kicker text-primary text-[0.8rem] mb-4">Community database &amp; sales insights hub</p>
          <h2 class="font-display uppercase text-white text-4xl md:text-6xl leading-[0.95] mb-5">Know exactly who to talk to.</h2>
          <p class="text-lg text-slate-300 leading-relaxed mb-6">
            This is what no magazine or conference can give you. Partners get access to a live, documented view of the recruitment market and the RecConnect membership, so your sales team stops guessing and starts having the right conversations.
          </p>
          <ul class="space-y-3 mb-8">
            {dataPoints.map((d) => (
              <li class="flex items-start gap-3 text-slate-200">
                <span class="mt-1 w-5 h-5 flex-shrink-0 bg-primary icon-shard flex items-center justify-center">
                  <svg class="w-3 h-3 text-brand-navy" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                {d}
              </li>
            ))}
          </ul>
          <p class="text-sm text-slate-500">Access is tiered by partnership level, from basic discovery through to premium intelligence for Category Partners.</p>
        </div>

        <!-- Stylised data card -->
        <div class="relative">
          <div class="absolute -inset-4 bg-primary/10 blur-[60px] rounded-full pointer-events-none"></div>
          <div class="relative rounded-2xl border border-white/10 bg-white/[0.04] p-5">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/10">
              <span class="kicker text-primary text-[0.65rem]">Member record</span>
              <span class="text-[0.65rem] text-slate-500 font-mono">RC-2026</span>
            </div>
            {[
              { k: 'Agency', v: 'Northbound Talent' },
              { k: 'Decision-maker', v: 'MD / Founder' },
              { k: 'Sector', v: 'Technology &amp; Engineering' },
              { k: 'Headcount', v: '45 (growth stage)' },
              { k: 'CRM', v: 'Bullhorn' },
              { k: 'Job board', v: 'LinkedIn Recruiter' },
            ].map((row) => (
              <div class="flex items-center justify-between py-2.5 border-b border-white/5">
                <span class="text-sm text-slate-500">{row.k}</span>
                <span class="text-sm text-white font-medium" set:html={row.v}></span>
              </div>
            ))}
            <p class="text-[0.7rem] text-slate-600 mt-4">Illustrative record. Real data is provided to partners in line with our privacy commitments.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WAYS TO SHOW UP ═══ -->
  <section class="relative overflow-hidden bg-white py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl mb-16">
        <p class="kicker text-primary-dark text-[0.8rem] mb-4">Ways to show up</p>
        <h2 class="font-display uppercase text-brand-navy text-4xl md:text-6xl leading-[0.95] mb-5">Get in front of them.</h2>
        <p class="text-lg text-slate-600 leading-relaxed">Beyond the directory and the data, there are bigger moments to put your brand in the room with the people who actually buy.</p>
      </div>

      <div class="space-y-16 md:space-y-24">
        {activations.map((a, i) => (
          <div class={`grid lg:grid-cols-2 gap-8 lg:gap-14 items-center ${i % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
            <div class="relative">
              <div class="absolute -inset-3 bg-primary/10 blur-[50px] rounded-3xl pointer-events-none"></div>
              <img src={a.img} alt="" class="relative w-full aspect-[4/3] object-cover rounded-2xl ring-1 ring-slate-200 shadow-xl" loading="lazy" />
            </div>
            <div>
              <p class="kicker text-primary-dark text-[0.75rem] mb-3">{a.kicker}</p>
              <h3 class="font-display uppercase text-brand-navy text-3xl md:text-5xl leading-[0.95] mb-4">{a.title}</h3>
              <p class="text-lg text-slate-600 leading-relaxed mb-6">{a.body}</p>
              <a href="#enquire" class="btn-primary text-sm px-6 py-2.5">{a.ctaLabel}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PACKAGES ═══ -->
  <section id="packages" class="relative overflow-hidden bg-white py-20 md:py-28 scroll-mt-24">
    <div class="absolute -top-16 -right-16 w-72 h-[26rem] bg-primary/[0.07] rotate-12 pointer-events-none" style="clip-path: polygon(20% 0, 100% 0, 80% 100%, 0 100%);"></div>
    <div class="absolute -bottom-20 -left-16 w-32 h-72 bg-gold/[0.08] -rotate-[22deg] pointer-events-none" style="clip-path: polygon(55% 0, 100% 0, 45% 100%, 0 100%);"></div>
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="kicker text-primary-dark text-[0.8rem] mb-4">Partner packages</p>
        <h2 class="font-display uppercase text-brand-navy text-4xl md:text-6xl leading-[0.95] mb-4">Choose your level</h2>
        <p class="text-lg text-slate-600">Every tier includes access to the community database and sales insights hub. The bigger the commitment, the deeper the access and visibility.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 items-start">
        {tiers.map((t) => (
          <div class={`rounded-xl p-7 flex flex-col h-full ${t.featured ? 'bg-white border-2 border-primary shadow-lg relative' : 'bg-slate-50 border border-slate-200'}`}>
            {t.featured && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                <span class="bg-primary text-brand-navy text-xs font-bold px-3 py-1 rounded-full">Recommended</span>
              </div>
            )}
            <div class="mb-5">
              <h3 class="text-lg font-bold text-brand-navy mb-1">{t.name}</h3>
              <p class="text-slate-500 text-sm mb-4 min-h-[2.5rem]">{t.tagline}</p>
              <div class="flex items-baseline gap-1">
                <span class="text-4xl font-bold text-brand-navy">{t.price}</span>
                <span class="text-slate-500">{t.per}</span>
              </div>
              <p class="text-slate-400 text-xs mt-1">{t.year}</p>
            </div>
            <ul class="space-y-2.5 mb-7 flex-1">
              {t.features.map((f) => (
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <svg class="w-4 h-4 text-primary-dark flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  {f}
                </li>
              ))}
            </ul>
            <a href={ENQUIRE} class={`block w-full text-center py-3 px-6 rounded-lg font-semibold text-sm transition-colors ${t.featured ? 'bg-primary text-brand-navy hover:bg-primary-dark' : 'border border-slate-300 text-slate-700 hover:bg-slate-100'}`}>
              Become a partner
            </a>
          </div>
        ))}
      </div>

      <p class="text-center text-slate-500 text-sm mt-10">
        Category Partners are expected to bring clients to at least one event per year, creating a great experience for their best customers in a context that is not a sales call.
      </p>
    </div>
  </section>

  <!-- ═══ ENQUIRY FORM ═══ -->
  <section id="enquire" class="relative overflow-hidden bg-brand-navy py-20 md:py-28 scroll-mt-24">
    <div class="absolute -bottom-20 -right-20 w-80 h-96 bg-coral/[0.06] rotate-[14deg] pointer-events-none" style="clip-path: polygon(20% 0, 100% 0, 80% 100%, 0 100%);"></div>
    <div class="absolute top-10 -left-16 w-64 h-96 bg-primary/[0.05] -rotate-[18deg] pointer-events-none" style="clip-path: polygon(55% 0, 100% 0, 45% 100%, 0 100%);"></div>

    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <div class="grid lg:grid-cols-5 gap-10 lg:gap-16 items-start">

        <!-- Left: pitch + what happens next -->
        <div class="lg:col-span-2">
          <p class="kicker text-primary text-[0.8rem] mb-4">Become a partner</p>
          <h2 class="font-display uppercase text-white text-4xl md:text-6xl leading-[0.92] mb-5">Let's talk partnership.</h2>
          <p class="text-slate-300 leading-relaxed mb-9">
            Tell us about your business and who you want to reach. We will show you the audience data and find the package that fits. No hard sell, no obligation.
          </p>

          <div class="space-y-6 mb-9">
            <div class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-primary/15 text-primary flex items-center justify-center text-sm font-bold">1</span>
              <div>
                <p class="text-white font-semibold text-sm">We learn what you are after</p>
                <p class="text-slate-400 text-sm leading-relaxed">A short, no-pressure chat about who you sell to and what a win looks like.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-primary/15 text-primary flex items-center justify-center text-sm font-bold">2</span>
              <div>
                <p class="text-white font-semibold text-sm">You see the audience data</p>
                <p class="text-slate-400 text-sm leading-relaxed">The real make-up of the RecConnect community, so you can judge the fit for yourself.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-primary/15 text-primary flex items-center justify-center text-sm font-bold">3</span>
              <div>
                <p class="text-white font-semibold text-sm">We match you to the right package</p>
                <p class="text-slate-400 text-sm leading-relaxed">From a simple listing to full category ownership. Only what earns its place.</p>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-4 rounded-xl border border-white/10 bg-white/[0.03] p-4">
            <img src="/images/authors/simon-lewis.jpg" alt="Simon Lewis" class="w-11 h-11 rounded-full object-cover flex-shrink-0" loading="lazy" />
            <div>
              <p class="text-sm text-slate-200 leading-snug">"Every partner enquiry comes to me personally."</p>
              <p class="text-xs text-slate-500 mt-0.5">Simon Lewis, Founder</p>
            </div>
          </div>
        </div>

        <!-- Right: premium form card + success -->
        <div class="lg:col-span-3">
          <div class="relative">
            <div class="absolute -inset-3 bg-primary/10 blur-[60px] rounded-3xl pointer-events-none"></div>
            <div class="relative rounded-2xl border border-white/10 bg-white p-6 md:p-8 shadow-2xl">

              <form data-lead action="/api/submit" data-success="Thanks. We'll be in touch shortly to talk partnership." novalidate>
                <input type="hidden" name="formType" value="partner" />
                <div class="absolute -left-[9999px]" aria-hidden="true">
                  <label>Leave this field empty<input type="text" name="rc_hp" tabindex="-1" autocomplete="off" data-1p-ignore="true" data-lpignore="true" /></label>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <label for="p-name" class="mb-1.5 block text-sm font-medium text-brand-navy">Name <span class="text-primary-dark">*</span></label>
                    <input id="p-name" name="name" type="text" required autocomplete="name" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" />
                  </div>
                  <div>
                    <label for="p-email" class="mb-1.5 block text-sm font-medium text-brand-navy">Email <span class="text-primary-dark">*</span></label>
                    <input id="p-email" name="email" type="email" required autocomplete="email" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" />
                  </div>
                  <div>
                    <label for="p-company" class="mb-1.5 block text-sm font-medium text-brand-navy">Company <span class="text-primary-dark">*</span></label>
                    <input id="p-company" name="company" type="text" required autocomplete="organization" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" />
                  </div>
                  <div>
                    <label for="p-role" class="mb-1.5 block text-sm font-medium text-brand-navy">Job title <span class="text-primary-dark">*</span></label>
                    <input id="p-role" name="role" type="text" required autocomplete="organization-title" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" />
                  </div>
                </div>
                <div class="mt-4">
                  <label for="p-interest" class="mb-1.5 block text-sm font-medium text-brand-navy">Package interest <span class="text-primary-dark">*</span></label>
                  <select id="p-interest" name="interest" required class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-slate-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20">
                    <option value="" disabled selected>Please choose...</option>
                    <option>Not sure yet</option>
                    <option>Category Partner</option>
                    <option>Featured Supplier</option>
                    <option>Listed Supplier</option>
                    <option>Trainer Membership</option>
                  </select>
                </div>
                <div class="mt-4">
                  <label for="p-message" class="mb-1.5 block text-sm font-medium text-brand-navy">What do you offer, and who do you want to reach? <span class="text-primary-dark">*</span></label>
                  <textarea id="p-message" name="message" rows="4" required class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"></textarea>
                </div>
                <div class="mt-6 flex flex-wrap items-center gap-4">
                  <button type="submit" class="btn-primary px-7 py-3 text-sm">Send enquiry</button>
                  <p data-status class="text-sm" role="status" aria-live="polite"></p>
                </div>
                <p class="mt-4 text-xs text-slate-400">We only use your details to reply. See our <a href="/privacy" class="underline hover:text-slate-600">privacy notice</a>.</p>
              </form>

              <!-- Success card: replaces the form on submit -->
              <div data-success-card hidden class="text-center py-6">
                <div class="mx-auto w-16 h-16 rounded-full bg-primary/15 flex items-center justify-center mb-5">
                  <svg class="w-8 h-8 text-primary-dark" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <h3 class="text-2xl font-bold text-brand-navy mb-3">Enquiry received.</h3>
                <p data-success-msg class="text-slate-600 max-w-md mx-auto mb-3 leading-relaxed">
                  Thanks, your enquiry is with us. We will be in touch within one working day to talk partnership.
                </p>
                <p class="text-sm text-slate-400 mb-7">A confirmation from Simon is on its way to your inbox. <span data-ref></span></p>
                <button type="button" data-again class="text-sm font-semibold text-primary-dark hover:text-brand-navy transition-colors">Send another enquiry</button>
              </div>

            </div>
          </div>
        </div>

      </div>

      <p class="text-sm text-slate-500 mt-8 text-center">
        Prefer email? <a href="mailto:hello@recconnect.co" class="text-primary hover:text-white transition-colors">hello@recconnect.co</a>
      </p>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLFormElement>('form[data-lead]').forEach((form) => {
      const statusEl = form.querySelector<HTMLElement>('[data-status]');
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const wrap = form.parentElement;
      const successCard = wrap?.querySelector<HTMLElement>('[data-success-card]') || null;
      const successMsg = successCard?.querySelector<HTMLElement>('[data-success-msg]') || null;
      const refEl = successCard?.querySelector<HTMLElement>('[data-ref]') || null;
      const againBtn = successCard?.querySelector<HTMLButtonElement>('[data-again]') || null;
      const invalid = ['ring-2', 'ring-red-400'];

      againBtn?.addEventListener('click', () => {
        if (successCard) successCard.hidden = true;
        form.hidden = false;
        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (statusEl) { statusEl.textContent = ''; statusEl.className = 'text-sm'; }
        form.querySelectorAll('[data-invalid]').forEach((el) => { el.classList.remove(...invalid); el.removeAttribute('data-invalid'); });
        const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
        const original = btn?.textContent || 'Send';
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
        try {
          const res = await fetch(form.getAttribute('action') || '/api/submit', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data),
          });
          const body = await res.json().catch(() => ({}));
          if (res.ok && body.ok) {
            form.reset();
            if (successCard) {
              const first = (data.name || '').trim().split(/\s+/)[0];
              if (successMsg && first) successMsg.textContent = `Thanks ${first}, your enquiry is with us. We will be in touch within one working day to talk partnership.`;
              if (refEl) refEl.textContent = body.ref ? `Ref ${body.ref}.` : '';
              form.hidden = true;
              successCard.hidden = false;
              successCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else if (statusEl) {
              statusEl.textContent = form.getAttribute('data-success') || 'Thanks, we will be in touch.'; statusEl.className = 'text-sm font-medium text-emerald-400';
            }
          } else {
            (body.fields || []).forEach((n: string) => { const el = form.querySelector(`[name="${n}"]`); if (el) { el.classList.add(...invalid); el.setAttribute('data-invalid', 'true'); } });
            if (statusEl) { statusEl.textContent = body.error || 'Something went wrong. Please try again.'; statusEl.className = 'text-sm font-medium text-red-400'; }
          }
        } catch {
          if (statusEl) { statusEl.textContent = 'Network error. Please try again.'; statusEl.className = 'text-sm font-medium text-red-400'; }
        } finally { if (btn) { btn.disabled = false; btn.textContent = original; } }
      });
    });
  </script>
</BaseLayout>
